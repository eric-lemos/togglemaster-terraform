{
  "uid": "togglemaster-ecosystem",
  "title": "ToggleMaster - Ecosystem",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["togglemaster"],
  "timezone": "browser",
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "CPU usage by pod (cores)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"togglemaster\",container!=\"\",container!=\"POD\"}[5m]))", "legendFormat": "{{pod}}"}]
    },
    {
      "id": 2,
      "title": "Memory working set by pod",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"togglemaster\",container!=\"\",container!=\"POD\"})", "legendFormat": "{{pod}}"}]
    },
    {
      "id": 3,
      "title": "Container restarts in the last 30 minutes",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"refId": "A", "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"togglemaster\"}[30m]))", "legendFormat": "{{pod}}"}]
    },
    {
      "id": 4,
      "title": "HTTP requests per second (requires OTel instrumentation)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"refId": "A", "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\".*-service\"}[5m]))", "legendFormat": "{{service_name}}"}]
    },
    {
      "id": 5,
      "title": "ToggleMaster container logs",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 16},
      "targets": [{"refId": "A", "expr": "{k8s_namespace_name=\"togglemaster\"}", "queryType": "range"}],
      "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}
    }
  ]
}
